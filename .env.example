# AI Provider ('auto', 'gemini', or 'groq') & Triage Pacing
# 'auto' uses Gemini when GEMINI_API_KEY is set, otherwise Groq when GROQ_API_KEY is set.
# Leave API keys empty to use built-in deterministic triage rules.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TURNS=4
LLM_LOG_TAIL_LINES=80
LLM_MAX_LOG_CHARS=4000
LLM_CONCURRENCY_LIMIT=1
LLM_INTER_REQUEST_DELAY_SECONDS=0.0
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.1

# Kubernetes Settings
KUBE_NAMESPACE=default
ENABLE_K8S_WATCHER=false
WATCHER_POLL_INTERVAL_SECONDS=15
ALERT_COOLDOWN_SECONDS=300
MANIFESTS_DIR=k8s/workloads
REPO_ROOT_DIR=.

# Remediation Guardrail Caps
MAX_MEMORY_LIMIT=1Gi
MIN_MEMORY_LIMIT=16Mi
ALLOW_OFFLINE_SIMULATION=true

# GitHub PR Automation (Leave token empty for Local Dry-Run Mode)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
GITHUB_BASE_BRANCH=main
DRY_RUN_MODE=true

# Output directory for proposal bundles
PROPOSALS_DIR=output/proposals
